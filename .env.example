# MCParasite — Environment Variables
# Copy this file to .env and fill in your keys.
# .env is git-ignored and never leaves your machine.

# ── LLM Providers ─────────────────────────────────────────────────────
# At least one required. Use 'local' channel for zero-dependency demos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# ── Communication Channels ────────────────────────────────────────────
# Only needed when testing real channel propagation (not required for local demos).
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
JIRA_API_TOKEN=
DISCORD_BOT_TOKEN=
NOTION_API_KEY=

# ── Dashboard ─────────────────────────────────────────────────────────
# Default: 5001. Docker Compose maps this to 8888 externally.
MCPARASITE_PORT=5001
